{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/sync/:path*",
      "destination": "/api?__vercel_path=/sync/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__vercel_path=/api/:path*"
    },
    {
      "source": "/:path((?!api/|sync/).*)",
      "destination": "/index.html"
    }
  ]
}
